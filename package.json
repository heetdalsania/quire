{
  "name": "quire-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && npm run build -w @quire/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty",
    "start": "node packages/cli/bin/quire.js",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}