{
  "name": "quire-monorepo",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build && npm run build -w @quire/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty",
    "verify": "npm run typecheck && npm test && npm run build:release && npm run check:release",
    "start": "node packages/cli/bin/quire.js",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
