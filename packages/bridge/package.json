{
  "name": "@quire/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bidirectional sync between a directory of Markdown files and Yjs documents.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./attribution": {
      "types": "./dist/src/attribution.d.ts",
      "default": "./dist/src/attribution.js"
    },
    "./comments": {
      "types": "./dist/src/comments.d.ts",
      "default": "./dist/src/comments.js"
    },
    "./provenance": {
      "types": "./dist/src/provenance.d.ts",
      "default": "./dist/src/provenance.js"
    },
    "./policy": {
      "types": "./dist/src/policy.d.ts",
      "default": "./dist/src/policy.js"
    },
    "./replay": {
      "types": "./dist/src/replay.d.ts",
      "default": "./dist/src/replay.js"
    }
  },
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "fast-diff": "^1.3.0",
    "yjs": "^13.6.21"
  },
  "main": "./dist/src/index.js"
}